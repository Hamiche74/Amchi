# ============================================\n# AMCHI PAYMENT GATEWAY - ENVIRONMENT CONFIG\n# ============================================\n\n# API Configuration\nAPI_TITLE=Amchi Payment Gateway\nAPI_VERSION=1.0.0\nAPI_DESCRIPTION=A payment gateway solution adapted to Niger and Africa's populations\nDEBUG=False\nENVIRONMENT=development\n\n# Server Configuration\nHOST=0.0.0.0\nPORT=8000\nALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0\n\n# ============================================\n# DATABASE CONFIGURATION\n# ============================================\nDATABASE_URL=postgresql://user:password@localhost:5432/amchi_db\nDATABASE_ECHO=False\nDATABASE_POOL_SIZE=20\nDATABASE_MAX_OVERFLOW=0\n\n# ============================================\n# JWT & SECURITY\n# ============================================\nSECRET_KEY=your-super-secret-key-change-this-in-production\nALGORITHM=HS256\nACCESS_TOKEN_EXPIRE_MINUTES=30\nREFRESH_TOKEN_EXPIRE_DAYS=7\n\n# ============================================\n# ORANGE MONEY INTEGRATION\n# ============================================\nORANGE_MONEY_API_KEY=your-orange-money-api-key\nORANGE_MONEY_API_SECRET=your-orange-money-api-secret\nORANGE_MONEY_MERCHANT_ID=your-merchant-id\nORANGE_MONEY_API_URL=https://api.orange.com/orange-money\nORANGE_MONEY_CALLBACK_URL=https://yourdomain.com/webhooks/orange-money\n\n# ============================================\n# MOOV MONEY INTEGRATION\n# ============================================\nMOOV_MONEY_API_KEY=your-moov-money-api-key\nMOOV_MONEY_API_SECRET=your-moov-money-api-secret\nMOOV_MONEY_MERCHANT_ID=your-merchant-id\nMOOV_MONEY_API_URL=https://api.moovmoney.com\nMOOV_MONEY_CALLBACK_URL=https://yourdomain.com/webhooks/moov-money\n\n# ============================================\n# WAVE INTEGRATION\n# ============================================\nWAVE_API_KEY=your-wave-api-key\nWAVE_API_SECRET=your-wave-api-secret\nWAVE_API_URL=https://api.wavemoney.io\nWAVE_CALLBACK_URL=https://yourdomain.com/webhooks/wave\n\n# ============================================\n# BANK API INTEGRATION\n# ============================================\nBANK_API_KEY=your-bank-api-key\nBANK_API_URL=https://api.yourbank.com\nBANK_API_MERCHANT_ID=your-merchant-id\n\n# ============================================\n# SMS & NOTIFICATIONS (Twilio)\n# ============================================\nTWILIO_ACCOUNT_SID=your-twilio-account-sid\nTWILIO_AUTH_TOKEN=your-twilio-auth-token\nTWILIO_PHONE_NUMBER=+227xxxxx\nTWILIO_ENABLED=True\n\n# ============================================\n# EMAIL CONFIGURATION\n# ============================================\nSMTP_HOST=smtp.gmail.com\nSMTP_PORT=587\nSMTP_USER=your-email@gmail.com\nSMTP_PASSWORD=your-app-password\nSMTP_FROM_EMAIL=noreply@amchi.com\nSMTP_FROM_NAME=Amchi Payment Gateway\nSMTP_ENABLED=True\n\n# ============================================\n# REDIS CONFIGURATION (Caching & Rate Limiting)\n# ============================================\nREDIS_URL=redis://localhost:6379\nREDIS_DB=0\nREDIS_PASSWORD=\n\n# ============================================\n# LOGGING CONFIGURATION\n# ============================================\nLOG_LEVEL=INFO\nLOG_FILE=logs/amchi.log\nLOG_FORMAT=json\n\n# ============================================\n# SECURITY & COMPLIANCE\n# ============================================\nCORS_ORIGINS=http://localhost:3000,http://localhost:8080\nRATE_LIMIT_ENABLED=True\nRATE_LIMIT_REQUESTS_PER_MINUTE=60\nRATE_LIMIT_REQUESTS_PER_HOUR=1000\n\n# ============================================\n# KYC & VERIFICATION\n# ============================================\nKYC_ENABLED=True\nKYC_VERIFICATION_TIMEOUT_HOURS=24\nMIN_TRANSACTION_AMOUNT=100\nMAX_TRANSACTION_AMOUNT=500000\nDAILY_LIMIT_AMOUNT=2000000\n\n# ============================================\n# FEATURE FLAGS\n# ============================================\nENABLE_P2P_TRANSFERS=True\nENABLE_MERCHANT_PAYMENTS=True\nENABLE_WITHDRAWAL=True\nENABLE_USSD=True\nENABLE_OFFLINE_MODE=True\n\n# ============================================\n# AWS CONFIGURATION (Optional - for file uploads)\n# ============================================\nAWS_ACCESS_KEY_ID=your-aws-access-key\nAWS_SECRET_ACCESS_KEY=your-aws-secret-key\nAWS_S3_BUCKET_NAME=amchi-uploads\nAWS_S3_REGION=us-east-1\n\n# ============================================\n# MONITORING & ANALYTICS\n# ============================================\nSENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id\nDATADOG_API_KEY=your-datadog-api-key\nENABLE_MONITORING=True\n\n# ============================================\n# TIMEZONE\n# ============================================\nTIMEZONE=Africa/Niamey\n